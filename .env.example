# Arquivo de referencia para desenvolvimento local
# Copie para os respectivos ambientes:
# - functions/.env  (backend)
# - web/.env.local  (frontend)

# Backend (Firebase Functions / Render)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://top-100-game-staging.onrender.com
OPENROUTER_APP_NAME=top-100-game
CORS_ORIGINS=http://localhost:3000,https://top-100-game.vercel.app

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5001/top-100-game/us-central1/api
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

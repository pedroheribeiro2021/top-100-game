# Arquivo de referência para desenvolvimento local
# Copie para os respectivos ambientes:
# - functions/.env  (backend)
# - web/.env.local  (frontend)

# Backend (Firebase Functions / Render)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
CORS_ORIGINS=http://localhost:3000,https://top-100-game.vercel.app

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5001/top-100-game/us-central1/api
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
